"""Shared DVD extraction implementation; also installed alongside the commands."""
import fcntl
from contextlib import contextmanager
from datetime import datetime, timezone
import hashlib
import json
import os
from pathlib import Path
import math
import re
import shlex
import shutil
import subprocess
import sys
import tempfile

FFMPEG = "/opt/ffmpeg-dvd/bin/ffmpeg"
FFPROBE = "/opt/ffmpeg-dvd/bin/ffprobe"


def digest(path):
    result = hashlib.sha256()
    with path.open("rb") as handle:
        for block in iter(lambda: handle.read(1024 * 1024), b""):
            result.update(block)
    return result.hexdigest()


def source_identity(source):
    source = source.resolve(strict=True)
    if source.is_file():
        return {"type": "file", "sha256": digest(source)}
    # Accept either a DVD directory or VIDEO_TS itself. Ignore unrelated files
    # (including extraction outputs) so placing output beside VIDEO_TS is safe.
    candidates = [source] if source.name.upper() == "VIDEO_TS" else [
        p for p in source.iterdir() if p.is_dir() and p.name.upper() == "VIDEO_TS"
    ]
    if len(candidates) != 1:
        raise ValueError("DVD directory must contain exactly one VIDEO_TS directory")
    files = sorted((p for p in candidates[0].iterdir()
                    if p.is_file() and p.suffix.upper() in {".IFO", ".BUP", ".VOB"}),
                   key=lambda p: p.name)
    if not files:
        raise ValueError("No DVD files found in VIDEO_TS")
    return {"type": "directory", "files": [
        {"file": p.name, "sha256": digest(p)} for p in files
    ]}


def run(command):
    result = subprocess.run(command, capture_output=True, text=True)
    if result.returncode:
        raise ValueError(f"{command[0]} failed ({result.returncode}): {result.stderr.strip()}")
    return result.stdout


def probe_dvd_streams(source, input_args):
    # libdvdread can write diagnostics directly to stdout, interleaving with JSON.
    with tempfile.TemporaryDirectory() as directory:
        report = Path(directory) / "streams.json"
        run([FFPROBE, "-v", "error", *input_args, "-preindex", "0",
             "-show_entries", "stream=index,codec_type,codec_name,sample_fmt,sample_rate,channels",
             "-of", "json", "-o", str(report), str(source)])
        return json.loads(report.read_text(encoding="utf-8"))["streams"]


def ifo_tool():
    local = Path(__file__).resolve().parent.parent / "build-ifo-dump"
    if local.is_file() and os.access(local, os.X_OK):
        return str(local)
    installed = shutil.which("dvd-ifo-dump")
    if not installed:
        raise ValueError("dvd-ifo-dump not found; build or install disc-archive-tools")
    return installed


def inventory(source, kind):
    if kind == "title":
        output = run(["lsdvd", "-c", str(source)])
        clock = r"(\d+):(\d{2}):(\d{2}\.\d+)"
        title_line = re.compile(r"^Title:\s*(\d+), Length:\s*" + clock + r" Chapters:\s*(\d+),")
        chapter_line = re.compile(r"^Chapter:\s*(\d+), Length:\s*" + clock)
        result = {}
        expected_counts = {}

        def seconds(parts):
            hours, minutes, seconds = map(float, parts)
            return hours * 3600 + minutes * 60 + seconds

        for line in output.splitlines():
            line = line.strip()
            if line.startswith("Title:"):
                match = title_line.match(line)
                if not match:
                    raise ValueError(f"Invalid DVD title metadata: {line}")
                number = int(match[1])
                name = f"title_{number:03d}.mkv"
                if number < 1 or name in result:
                    raise ValueError(f"Invalid DVD title number: {number}")
                chapter_count = int(match[5])
                chapters = []
                result[name] = (number, seconds(match.groups()[1:4]), chapters)
                if chapter_count < 1:
                    raise ValueError(f"Title {number} has no authored chapters")
                # Check every title even if its chapter records are absent.
                expected_counts[name] = chapter_count
            elif line.startswith("Chapter:"):
                match = chapter_line.match(line)
                if not match or not result or int(match[1]) != len(chapters) + 1:
                    raise ValueError(f"Invalid DVD chapter metadata: {line}")
                chapters.append(seconds(match.groups()[1:4]))
        if not result or any(len(item[2]) != expected_counts[name] for name, item in result.items()):
            raise ValueError("Could not read complete authored DVD title metadata")
        return result
    output = run([ifo_tool(), "--candidates", str(source)])
    result = {}
    for line in output.splitlines():
        if not line.strip():
            continue
        if line.startswith("libdvdread:"):
            print(line, file=sys.stderr)
            continue
        fields = line.split()
        if len(fields) != 3 or not all(s.isdecimal() for s in fields):
            raise ValueError(f"Invalid menu candidate: {line!r}")
        vts, lu, pgc = map(int, fields)
        if lu < 1 or pgc < 1:
            raise ValueError(f"Invalid menu candidate: {line!r}")
        name = f"vts_{vts:03d}_lu_{lu:03d}_pgc_{pgc:03d}.mkv"
        if name in result:
            raise ValueError(f"Duplicate menu candidate: {line!r}")
        result[name] = ["-menu", "1", "-menu_vts", str(vts), "-menu_lu", str(lu), "-pgc", str(pgc)]
    return result


def atomic_json(path, data):
    fd, name = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    temporary = Path(name)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            json.dump(data, handle, indent=2)
            handle.write("\n")
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(temporary, path)
    finally:
        temporary.unlink(missing_ok=True)



def publish_manifest(root, data):
    """Publish a complete manifest without replacing any existing file."""
    fd, name = tempfile.mkstemp(prefix=".manifest.", dir=root)
    temporary = Path(name)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            json.dump(data, handle, indent=2)
            handle.write("\n")
            handle.flush()
            os.fsync(handle.fileno())
        stamp = datetime.now(timezone.utc).strftime("%Y-%m-%d-%H%M%S-UTC")
        index = 0
        while True:
            if index == 0:
                target = root / "manifest.json"
            else:
                suffix = "" if index == 1 else f"-{index - 1}"
                target = root / f"verified-{stamp}{suffix}.json"
            try:
                os.link(temporary, target)
                return target
            except FileExistsError:
                index += 1
    finally:
        temporary.unlink(missing_ok=True)

def receipt_path(path):
    return path.with_name(path.name + ".receipt.json")


def matching_receipt(path, identity):
    try:
        receipt = json.loads(receipt_path(path).read_text())
        if (receipt.get("version") in (1, 2, 3) and receipt.get("source") == identity
                and receipt.get("file") == path.name
                and receipt.get("sha256") == digest(path)):
            return receipt
    except (OSError, ValueError, AttributeError):
        pass
    return None


def probe(path):
    data = json.loads(run([FFPROBE, "-v", "error", "-show_format", "-show_streams",
                           "-show_chapters", "-of", "json", str(path)]))
    streams = []
    for stream in data.get("streams", []):
        item = {k: stream.get(k) for k in ("index", "codec_type", "codec_name")}
        if stream.get("codec_type") == "video":
            item.update({k: stream.get(k) for k in ("width", "height")})
        if stream.get("codec_type") == "audio":
            item.update({k: stream.get(k) for k in ("sample_rate", "channels")})
        item.update({k: v for k, v in stream.get("tags", {}).items() if k in {"language", "title"}})
        streams.append(item)
    if not any(s["codec_type"] == "video" for s in streams):
        raise ValueError("No video stream found")
    try:
        duration = float(data.get("format", {}).get("duration"))
    except (TypeError, ValueError):
        duration = None
    try:
        chapter_starts = [float(chapter["start_time"]) for chapter in data.get("chapters", [])]
    except (KeyError, ValueError, TypeError) as exc:
        raise ValueError("Invalid MKV chapter timestamps") from exc
    return {"verified": True, "duration": duration,
            "chapter_count": len(chapter_starts), "chapter_starts": chapter_starts, "streams": streams}


def duration_matches(expected, observed):
    return (observed is not None and math.isfinite(observed)
            and abs(expected - observed) <= 1 + expected * 0.0015)


def completeness(title, observed):
    _, duration, chapters = title
    expected = {"duration": duration, "chapter_count": len(chapters)}
    actual = {key: observed.get(key) for key in expected}
    result = {"expected": expected, "observed": actual}
    # FFmpeg omits chapter markers for a single-chapter title. Its whole
    # runtime is the implicit chapter.
    count_ok = actual["chapter_count"] == len(chapters) or (
        len(chapters) == 1 and actual["chapter_count"] == 0
    )
    if actual["duration"] is None or not math.isfinite(actual["duration"]):
        result["error"] = "Extracted media has no usable duration"
    elif not count_ok:
        result["error"] = (
            f"Expected {duration:.3f}s and {len(chapters)} chapters; "
            f"found {actual['duration']}s and {actual['chapter_count']} chapters"
        )
    elif not duration_matches(duration, actual["duration"]):
        result["warnings"] = [
            f"Authored DVD metadata reports {duration:.3f}s; "
            f"the extracted media reports {actual['duration']:.3f}s"
        ]
    return result


def write_receipt(path, identity, checksum, check=None, comparison=None):
    receipt = {"version": 1, "source": identity, "file": path.name, "sha256": checksum}
    if check is not None:
        receipt.update({"version": 2,
                        "status": "incomplete" if "error" in check else "complete", **check})
    if comparison is not None:
        receipt.update({"version": 3, "source_comparison": comparison,
                        "status": "complete" if comparison.get("verified") and
                        (check is None or "error" not in check) else "incomplete"})
    atomic_json(receipt_path(path), receipt)


def remux_dvd(source, options, destination):
    input_args = ["-f", "dvdvideo", *options]
    streams = probe_dvd_streams(source, input_args)
    codecs = ["-c", "copy"]
    for stream in streams:
        if stream.get("codec_name") == "pcm_dvd":
            codec = "pcm_s16le" if stream.get("sample_fmt") == "s16" else "pcm_s24le"
            codecs.extend([f"-c:{stream['index']}", codec])
    subprocess.run([FFMPEG, "-nostdin", "-xerror", "-abort_on", "empty_output", "-y",
                    *input_args, "-i", str(source), "-map", "0", *codecs,
                    "-f", "matroska", str(destination)], check=True)


def packet_counts(path):
    data = json.loads(run([FFPROBE, "-v", "error", "-count_packets",
                           "-show_entries", "stream=index,nb_read_packets",
                           "-of", "json", str(path)]))
    return {stream["index"]: int(stream.get("nb_read_packets", 0))
            for stream in data["streams"]}


def recover_chapters(source, title, destination):
    number, _, chapters = title
    with tempfile.TemporaryDirectory(prefix=".chapters-", dir=destination.parent) as directory:
        work = Path(directory)
        concat = ["ffconcat version 1.0"]
        metadata = [";FFMETADATA1"]
        elapsed = 0
        streams = None
        expected_packets = {}
        for chapter, expected in enumerate(chapters, 1):
            segment = work / f"{chapter:03d}.mkv"
            options = ["-title", str(number), "-trim", "0", "-preindex", "0",
                       "-chapter_start", str(chapter), "-chapter_end", str(chapter)]
            try:
                remux_dvd(source, options, segment)
                observed = probe(segment)
                duration = observed["duration"]
                if duration is None or not math.isfinite(duration) or duration <= 0:
                    raise ValueError(f"chapter has no usable duration: {duration}")
                if not duration_matches(expected, duration):
                    print(f"Warning: chapter {chapter}: authored DVD metadata reports "
                          f"{expected:.3f}s; extracted media reports {duration:.3f}s",
                          file=sys.stderr)
                if streams is not None and streams != observed["streams"]:
                    raise ValueError("stream layout differs from the first chapter")
                streams = observed["streams"]
                for index, count in packet_counts(segment).items():
                    expected_packets[index] = expected_packets.get(index, 0) + count
            except (OSError, ValueError, subprocess.CalledProcessError) as exc:
                raise ValueError(f"Title {number}, chapter {chapter}: {exc}") from exc
            milliseconds = round(duration * 1000)
            concat.extend([f"file {segment.name}", f"duration {milliseconds / 1000:.3f}"])
            metadata.extend(["[CHAPTER]", "TIMEBASE=1/1000",
                             f"START={elapsed}", f"END={elapsed + milliseconds}"])
            elapsed += milliseconds

        (work / "chapters.ffconcat").write_text("\n".join(concat) + "\n")
        (work / "chapters.ffmetadata").write_text("\n".join(metadata) + "\n")
        try:
            subprocess.run([FFMPEG, "-nostdin", "-xerror", "-abort_on", "empty_output", "-y",
                            "-f", "concat", "-i", str(work / "chapters.ffconcat"),
                            "-f", "ffmetadata", "-i", str(work / "chapters.ffmetadata"),
                            "-map", "0", "-map_chapters", "1", "-c", "copy",
                            "-f", "matroska", str(destination)], check=True)
        except subprocess.CalledProcessError as exc:
            raise ValueError(f"Title {number}: failed to join chapter segments") from exc
        if packet_counts(destination) != expected_packets:
            raise ValueError(f"Title {number}: packet counts changed during chapter join")
        print(f"Title {number}: chapter join preserved packet counts {expected_packets}")


def gallery_tool():
    local = Path(__file__).resolve().parent.parent / "build-gallery-nav"
    if local.is_file() and os.access(local, os.X_OK):
        return str(local)
    installed = shutil.which("dvd-gallery-nav")
    if not installed:
        raise ValueError("dvd-gallery-nav not found; build or install disc-archive-tools")
    return installed


def gallery_inventory(source):
    result = {}
    for line in run([gallery_tool(), "inventory", str(source)]).splitlines():
        if line.startswith("gallery "):
            number, *chapters = map(int, line.split()[1:])
            result[number] = set(chapters)
    return result


GALLERY_ACTIONS = {
    "previous": "Previous chapter", "next": "Next chapter", "return": "Return",
    "root-menu": "Root menu", "title-menu": "Title menu",
}
GALLERY_EXITS = {"root-menu": "DVD root menu", "title-menu": "DVD title menu",
                 "stop": "End of DVD playback"}
PNG_HEADER = b"\x89PNG\x0d\x0a\x1a\x0a"


def gallery_point(source, title, chapter, action):
    output = run([gallery_tool(), "trace", str(source), str(title), str(chapter), action])
    rows = [line.split()[1:] for line in output.splitlines() if line.startswith("point ")]
    if len(rows) != (1 if action == "entry" else 2):
        raise ValueError(f"Unexpected navigation trace for title {title} chapter {chapter} ({action})")

    def parse(row):
        if row[0] == "still":
            return tuple(map(int, row[1:]))
        if row[0] == "exit" and row[1] in GALLERY_EXITS:
            return row[1]
        if row == ["unavailable"]:
            return None
        raise ValueError(f"Unknown DVD gallery event: {row}")

    return parse(rows[0]), parse(rows[-1])


def confirmed_galleries(source):
    result = {}
    for title, chapters in gallery_inventory(source).items():
        first = min(chapters)
        still, _ = gallery_point(source, title, first, "entry")
        if not isinstance(still, tuple) or still[:2] != (title, first) or still[4] != 255:
            raise ValueError(f"Title {title} chapter {first}: IFO still disagrees with DVD playback")
        result[title] = chapters
    return result


def gallery_id(still):
    title, chapter, pgc, cell, *_ = still
    return f"t{title:03d}-p{chapter:03d}-pgc{pgc:03d}-c{cell:03d}"


def gallery_graph(source, title, galleries, cache):
    if title not in galleries:
        raise ValueError(f"Title {title} is not a confirmed DVD still gallery")
    entry, _ = gallery_point(source, title, 1, "entry")
    pending = [entry]
    nodes = {}
    while pending:
        still = pending.pop()
        number, chapter, pgc, cell, hold, buttons, aspect = still
        key = gallery_id(still)
        if key in nodes:
            continue
        if (chapter not in galleries.get(number, ()) or hold != 255 or buttons or aspect not in (0, 3)):
            raise ValueError(f"Unsupported still or buttons at title {number}, chapter {chapter}, cell {cell}")
        if still not in cache:
            transitions = {}
            for action in GALLERY_ACTIONS:
                start, target = gallery_point(source, number, chapter, action)
                if start != still:
                    raise ValueError(f"Cannot replay title {number}, chapter {chapter}, cell {cell} ({action})")
                if target is not None:
                    transitions[action] = target
            cache[still] = transitions
        actions = {}
        for action, target in cache[still].items():
            if isinstance(target, tuple):
                actions[action] = {"image": gallery_id(target)}
                pending.append(target)
            else:
                actions[action] = {"exit": target}
        nodes[key] = {"title": number, "chapter": chapter, "pgc": pgc, "cell": cell,
                      "hold": "indefinite", "aspect": "16/9" if aspect == 3 else "4/3",
                      "image": f"{key}.png", "actions": actions}
    visited = {node["chapter"] for node in nodes.values() if node["title"] == title}
    missing = galleries[title] - visited
    if missing:
        raise ValueError(f"Title {title}: could not reach still chapters {sorted(missing)}")
    return {"entry": gallery_id(entry), "images": nodes}


def gallery_page(graph):
    data = json.dumps(graph, separators=(",", ":")).replace("<", "\\u003c")
    return """<!doctype html>
<html lang="en">
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>DVD still gallery</title>
<style>
body { margin: auto; padding: 1rem; max-width: 64rem; background: #161616; color: #eee;
       font: 1rem system-ui, sans-serif; }
[hidden] { display: none !important; }
img { display: block; width: 100%; max-height: 78vh; object-fit: fill; background: black; }
nav { display: flex; flex-wrap: wrap; gap: .5rem; }
button { font: inherit; padding: .45rem .8rem; }
</style>
<h1>DVD still gallery</h1>
<img id="still" alt="DVD gallery still" hidden>
<p id="position" role="status"></p>
<nav id="controls" aria-label="DVD controls"></nav>
<script>
const graph = """ + data + """;
const labels = """ + json.dumps(GALLERY_ACTIONS) + """;
const exits = """ + json.dumps(GALLERY_EXITS) + """;
const picture = document.querySelector("#still");
const position = document.querySelector("#position");
const controls = document.querySelector("#controls");
let current;
function button(label, callback) {
    const control = document.createElement("button");
    control.textContent = label;
    control.onclick = callback;
    controls.append(control);
}
function show(id) {
    current = graph.images[id];
    picture.hidden = false;
    picture.style.aspectRatio = current.aspect;
    picture.style.width = `min(100%, calc(78vh * ${current.aspect}))`;
    picture.src = current.image;
    position.textContent = `Title ${current.title} · Chapter ${current.chapter}`;
    controls.replaceChildren();
    for (const action of Object.keys(labels)) {
        if (current.actions[action]) button(labels[action], () => act(action));
    }
}
function act(action) {
    const target = current?.actions[action];
    if (!target) return;
    if (target.image) {
        show(target.image);
        Array.from(controls.children).find(control => control.textContent === labels[action])?.focus();
    } else {
        current = null;
        picture.hidden = true;
        position.textContent = `DVD destination: ${exits[target.exit]}`;
        controls.replaceChildren();
        button("Restart gallery", () => show(graph.entry));
        controls.firstElementChild.focus();
    }
}
document.addEventListener("keydown", event => {
    const action = {"ArrowLeft": "previous", "ArrowRight": "next"}[event.key];
    if (action && current?.actions[action]) {
        event.preventDefault();
        act(action);
    }
});
show(graph.entry);
</script>
"""


def gallery_image_hash(path):
    with path.open("rb") as handle:
        if handle.read(len(PNG_HEADER)) != PNG_HEADER:
            raise ValueError(f"Invalid gallery image: {path.name}")
    return digest(path)


def verify_gallery(path, identity, title, graph):
    record = json.loads((path / "manifest.json").read_text(encoding="utf-8"))
    if (not isinstance(record, dict) or record.get("version") != 1
            or record.get("source") != identity or record.get("title") != title):
        raise ValueError("Gallery manifest does not match the source title")
    if record.get("navigation") != graph:
        raise ValueError("Gallery stills or navigation do not match the DVD")
    checksums = record.get("images")
    if not isinstance(checksums, dict) or set(checksums) != {
            node["image"] for node in graph["images"].values()}:
        raise ValueError("Gallery image inventory does not match the DVD")
    for filename, checksum in checksums.items():
        if gallery_image_hash(path / filename) != checksum:
            raise ValueError(f"Gallery image checksum mismatch: {filename}")
    if (path / "index.html").read_text(encoding="utf-8") != gallery_page(graph):
        raise ValueError("Gallery page does not match its verified navigation")
    return len(checksums)


def gallery_destination(root, title):
    return root / "galleries" / f"title_{title:03d}"


def gallery_command(source, destination, title):
    executable = Path(__file__).resolve().with_name("dvd-gallery-extract")
    return shlex.join([str(executable), str(source), str(title), str(destination)])


def extract_gallery(source, title, destination):
    identity = source_identity(source)
    graph = gallery_graph(source, title, confirmed_galleries(source), {})
    publish_gallery(source, title, destination, identity, graph)


def publish_gallery(source, title, destination, identity, graph):
    destination.parent.mkdir(parents=True, exist_ok=True)
    if destination.exists():
        verify_gallery(destination, identity, title, graph)
        print(f"Gallery verified: {destination / 'index.html'}")
        return
    with tempfile.TemporaryDirectory(prefix=".gallery-", dir=destination.parent) as directory:
        work = Path(directory) / "gallery"
        work.mkdir()
        checksums = {}
        for node in graph["images"].values():
            number, chapter = str(node["title"]), str(node["chapter"])
            image = work / node["image"]
            try:
                run([FFMPEG, "-nostdin", "-v", "error", "-xerror", "-f", "dvdvideo",
                     "-title", number, "-chapter_start", chapter, "-chapter_end", chapter,
                     "-trim", "0", "-preindex", "0", "-i", str(source),
                     "-map", "0:v:0", "-c:v", "png", "-f", "image2", "-update", "1", str(image)])
                checksums[image.name] = gallery_image_hash(image)
            except (OSError, ValueError) as exc:
                raise ValueError(f"Could not extract title {number} chapter {chapter}: {exc}") from exc
        (work / "index.html").write_text(gallery_page(graph), encoding="utf-8")
        atomic_json(work / "manifest.json", {"version": 1, "source": identity, "title": title,
                                             "navigation": graph, "images": checksums})
        verify_gallery(work, identity, title, graph)
        os.rename(work, destination)
    print(f"Gallery exported: {destination / 'index.html'}")


class SourceComparisonError(ValueError):
    """The extracted media could not be matched with the DVD source."""


@contextmanager
def probe_records(command, prefix):
    """Yield ffprobe records while keeping libdvdread diagnostics out of them."""
    with tempfile.TemporaryFile(mode="w+") as errors:
        process = subprocess.Popen(command, stdout=subprocess.PIPE, stderr=errors,
                                   text=True, encoding="utf-8", errors="replace")
        def records():
            for line in process.stdout:
                if not line.startswith(prefix):
                    continue
                yield dict(field.split("=", 1) for field in line.strip().split("|") if "=" in field)
        try:
            yield records()
            if process.wait():
                errors.seek(0)
                raise SourceComparisonError(f"DVD comparison probe failed: {errors.read().strip()}")
        finally:
            if process.poll() is None:
                process.terminate()
            process.stdout.close()
            process.wait()


def dvd_input(source, options):
    # The chapter index can follow DVD commands and stop before the authored
    # title ends. Compare using direct reads and, if necessary, chapter reads.
    filtered = []
    index = 0
    while index < len(options):
        if options[index] == "-preindex":
            index += 2
        else:
            filtered.append(options[index])
            index += 1
    return ["-f", "dvdvideo", *filtered, "-preindex", "0", str(source)]


def packet_command(input_args, index):
    return [FFPROBE, "-v", "error", *input_args[:-1], "-select_streams", str(index),
            "-show_packets", "-show_entries", "packet=pts_time,dts_time,duration_time,data_hash,flags",
            "-show_data_hash", "sha256", "-of", "compact=p=0:nk=0", input_args[-1]]


def frame_command(input_args, index):
    return [FFPROBE, "-v", "error", *input_args[:-1], "-select_streams", str(index),
            "-show_frames", "-show_entries", "frame=pts_time,duration_time,nb_samples,sample_fmt,channels",
            "-of", "compact=p=0:nk=0", input_args[-1]]


def timestamp(record, field):
    value = record.get(field)
    if value in (None, "N/A"):
        return None
    try:
        value = float(value)
    except ValueError as exc:
        raise SourceComparisonError(f"Invalid {field} in DVD comparison") from exc
    if not math.isfinite(value):
        raise SourceComparisonError(f"Invalid {field} in DVD comparison")
    return value


def compare_packet_stream(source, options, output, source_index, output_index,
                          chapter_numbers, offsets, expected_durations, kind,
                          duration_warnings=None, require_duration_match=True):
    output_args = [str(output)]
    output_command = packet_command(output_args, output_index)
    counts = []
    with probe_records(output_command, "pts_time=") as output_records:
        for chapter in chapter_numbers:
            chapter_options = list(options)
            if chapter is not None:
                chapter_options.extend(["-chapter_start", str(chapter), "-chapter_end", str(chapter)])
            source_args = dvd_input(source, chapter_options)
            source_command = packet_command(source_args, source_index)
            first_pts = None
            last_end = None
            count = 0
            with probe_records(source_command, "pts_time=") as source_records:
                for original in source_records:
                    actual = next(output_records, None)
                    count += 1
                    label = f"{kind} stream {source_index}, chapter {chapter or 'whole'}, packet {count}"
                    if actual is None:
                        raise SourceComparisonError(f"{label}: output ended early")
                    if "C" in original.get("flags", "") or "C" in actual.get("flags", ""):
                        raise SourceComparisonError(f"{label}: source or output packet is corrupt")
                    if not original.get("data_hash") or original["data_hash"] != actual.get("data_hash"):
                        raise SourceComparisonError(f"{label}: packet content differs from source")
                    source_pts = timestamp(original, "pts_time")
                    output_pts = timestamp(actual, "pts_time")
                    if kind == "video" and first_pts is None:
                        if source_pts is None or output_pts is None:
                            raise SourceComparisonError(f"{label}: missing video timestamp")
                        first_pts = source_pts
                        offsets[chapter] = output_pts - source_pts
                    if chapter not in offsets:
                        raise SourceComparisonError(f"{label}: cannot establish timestamp offset")
                    fields = ("pts_time", "duration_time") if kind == "video" else (
                        "pts_time", "dts_time", "duration_time")
                    for field in fields:
                        before = timestamp(original, field)
                        after = timestamp(actual, field)
                        if before is None and after is None:
                            if field == "pts_time":
                                raise SourceComparisonError(f"{label}: presentation timing is unavailable")
                            continue
                        if before is None or after is None:
                            raise SourceComparisonError(f"{label}: {field} is unavailable for comparison")
                        expected = before if field == "duration_time" else before + offsets[chapter]
                        if abs(expected - after) > 0.003:
                            raise SourceComparisonError(f"{label}: {field} differs from source")
                    if kind == "video" and source_pts is not None:
                        duration = timestamp(original, "duration_time") or 0
                        last_end = max(last_end if last_end is not None else source_pts,
                                       source_pts + duration)
            if kind == "video":
                if not count or first_pts is None or last_end is None:
                    raise SourceComparisonError(f"Video source chapter {chapter or 'whole'} is empty")
                duration = expected_durations.get(chapter)
                if duration is not None and last_end <= first_pts:
                    raise SourceComparisonError(
                        f"Video source chapter {chapter or 'whole'} has no usable duration"
                    )
                if duration is not None and not duration_matches(duration, last_end - first_pts):
                    message = (
                        f"Authored DVD metadata reports {duration:.3f}s for "
                        f"{'chapter ' + str(chapter) if chapter is not None else 'the title'}; "
                        f"the source video packets span {last_end - first_pts:.3f}s"
                    )
                    if require_duration_match:
                        raise SourceComparisonError(message)
                    if duration_warnings is not None:
                        duration_warnings.append(message)
            counts.append(count)
        if next(output_records, None) is not None:
            raise SourceComparisonError(f"{kind} stream {output_index}: output has extra packets")
    return counts


def pcm_hash(source, options_list, output, source_index, output_index, sample_fmt):
    if sample_fmt not in ("s16", "s32"):
        raise SourceComparisonError(f"Unsupported DVD LPCM sample format: {sample_fmt}")
    # Normalize both sides to 32 bits so a change from 16- to 20/24-bit
    # samples cannot be hidden by converting both sides down to 16 bits.
    codec = "pcm_s32le"
    raw_format = "s32le"

    def update_samples(hasher, input_args, index):
        read_fd, write_fd = os.pipe()
        with tempfile.TemporaryFile(mode="w+") as errors:
            command = [FFMPEG, "-nostdin", "-v", "error", "-xerror", *input_args[:-1],
                       "-i", input_args[-1], "-map", f"0:{index}", "-c:a", codec,
                       "-f", raw_format, f"pipe:{write_fd}"]
            try:
                process = subprocess.Popen(command, stdout=subprocess.DEVNULL, stderr=errors,
                                           pass_fds=(write_fd,))
            except Exception:
                os.close(read_fd)
                os.close(write_fd)
                raise
            os.close(write_fd)
            total = 0
            try:
                with os.fdopen(read_fd, "rb") as samples:
                    for block in iter(lambda: samples.read(1024 * 1024), b""):
                        hasher.update(block)
                        total += len(block)
                if process.wait():
                    errors.seek(0)
                    raise SourceComparisonError(f"DVD LPCM decoding failed: {errors.read().strip()}")
            finally:
                if process.poll() is None:
                    process.terminate()
                process.wait()
            return total

    before, after = hashlib.sha256(), hashlib.sha256()
    input_bytes = sum(update_samples(before, dvd_input(source, opts), source_index) for opts in options_list)
    output_bytes = update_samples(after, [str(output)], output_index)
    if not input_bytes:
        raise SourceComparisonError(f"PCM stream {source_index}: source produced no samples")
    if input_bytes != output_bytes or before.digest() != after.digest():
        raise SourceComparisonError(f"PCM stream {source_index}: decoded samples differ from source")
    return input_bytes


def compare_pcm_timing(source, options_list, output, source_index, output_index, sample_rate,
                       offsets, chapters, sample_fmt, channels):
    try:
        rate = int(sample_rate)
        if rate <= 0:
            raise ValueError()
    except (TypeError, ValueError) as exc:
        raise SourceComparisonError(f"PCM stream {source_index}: invalid sample rate") from exc

    def frame_samples(frame, label, tolerance):
        try:
            count = int(frame["nb_samples"])
            frame_channels = int(frame["channels"])
        except (KeyError, ValueError) as exc:
            raise SourceComparisonError(f"{label} lacks a sample or channel count") from exc
        duration = timestamp(frame, "duration_time")
        if (count <= 0 or frame_channels != channels or frame.get("sample_fmt") != sample_fmt
                or duration is None or abs(duration - count / rate) > tolerance):
            raise SourceComparisonError(f"{label} has an unsupported PCM format or sample rate change")
        return count

    with probe_records(frame_command([str(output)], output_index), "pts_time=") as output_frames:
        current = None
        output_used = 0
        for chapter, options in zip(chapters, options_list):
            with probe_records(frame_command(dvd_input(source, options), source_index), "pts_time=") as source_frames:
                for original in source_frames:
                    source_pts = timestamp(original, "pts_time")
                    source_samples = frame_samples(original, "DVD PCM frame", 0.0001)
                    if source_pts is None:
                        raise SourceComparisonError("DVD PCM frame lacks usable timing")
                    source_used = 0
                    while source_used < source_samples:
                        if current is None:
                            current = next(output_frames, None)
                            output_used = 0
                            if current is None:
                                raise SourceComparisonError("PCM output ended before the source")
                        output_pts = timestamp(current, "pts_time")
                        output_samples = frame_samples(current, "PCM output frame", 0.0011)
                        if output_pts is None:
                            raise SourceComparisonError("PCM output frame lacks usable timing")
                        source_time = source_pts + offsets[chapter] + source_used / rate
                        output_time = output_pts + output_used / rate
                        if abs(source_time - output_time) > 0.003:
                            raise SourceComparisonError(f"PCM stream {source_index}: sample timing differs from source")
                        matched = min(source_samples - source_used, output_samples - output_used)
                        source_used += matched
                        output_used += matched
                        if output_used == output_samples:
                            current = None
        if current is not None or next(output_frames, None) is not None:
            raise SourceComparisonError("PCM output has extra decoded samples")


def compare_dvd_media(source, options, output, title=None, chapters=False):
    input_args = ["-f", "dvdvideo", *options]
    source_streams = probe_dvd_streams(source, input_args)
    observed = probe(output)
    output_streams = observed["streams"]
    if len(source_streams) != len(output_streams):
        raise SourceComparisonError("DVD and MKV stream counts differ")
    indexes = [stream.get("index") for stream in source_streams]
    if any(not isinstance(index, int) for index in indexes) or len(set(indexes)) != len(indexes):
        raise SourceComparisonError("DVD source stream indexes are missing or ambiguous")
    for original, actual in zip(source_streams, output_streams):
        if not isinstance(actual.get("index"), int):
            raise SourceComparisonError("MKV stream index is missing")
        codec = original.get("codec_name")
        expected_codec = ("pcm_s16le" if original.get("sample_fmt") == "s16" else "pcm_s24le") if codec == "pcm_dvd" else codec
        if actual.get("codec_name") != expected_codec or original.get("codec_type") != actual.get("codec_type"):
            raise SourceComparisonError(f"DVD stream {original['index']} does not match MKV stream {actual['index']}")
        if codec == "pcm_dvd" and (str(original.get("sample_rate")) != str(actual.get("sample_rate"))
                                    or original.get("channels") != actual.get("channels")):
            raise SourceComparisonError(f"DVD PCM stream {original['index']} format differs from MKV")
    videos = [(original, actual) for original, actual in zip(source_streams, output_streams)
              if original.get("codec_type") == "video"]
    if len(videos) != 1:
        raise SourceComparisonError("Source comparison requires one identifiable video stream")

    chapter_numbers = list(range(1, len(title[2]) + 1)) if chapters and title else [None]
    durations = ({number: title[2][number - 1] for number in chapter_numbers}
                 if chapters else {None: title[1]} if title else {})
    offsets = {}
    comparison = {"verified": True, "method": "chapters" if chapters else "whole", "streams": []}
    duration_warnings = []
    original, actual = videos[0]
    counts = compare_packet_stream(source, options, output, original["index"], actual["index"],
                                   chapter_numbers, offsets, durations, "video",
                                   duration_warnings=duration_warnings,
                                   require_duration_match=bool(title and len(title[2]) > 1 and not chapters))
    if duration_warnings:
        comparison["warnings"] = duration_warnings
    if chapters:
        starts = observed["chapter_starts"]
        if len(starts) != len(chapter_numbers) or any(
                not math.isfinite(start) or abs(offsets[number] - start) > 0.15
                for number, start in zip(chapter_numbers, starts)):
            raise SourceComparisonError("Chapter timestamps do not match the source video")
    comparison["streams"].append({"index": actual["index"], "method": "packet_sha256", "packets": sum(counts)})
    for original, actual in zip(source_streams, output_streams):
        kind = original.get("codec_type")
        if kind == "video":
            continue
        if kind not in ("audio", "subtitle"):
            raise SourceComparisonError(f"Unsupported source stream type: {kind}")
        if original.get("codec_name") == "pcm_dvd":
            options_list = []
            for chapter in chapter_numbers:
                chapter_options = list(options)
                if chapter is not None:
                    chapter_options.extend(["-chapter_start", str(chapter), "-chapter_end", str(chapter)])
                options_list.append(chapter_options)
            count = pcm_hash(source, options_list, output, original["index"], actual["index"], original.get("sample_fmt"))
            compare_pcm_timing(source, options_list, output, original["index"], actual["index"],
                               original.get("sample_rate"), offsets, chapter_numbers,
                               original.get("sample_fmt"), original.get("channels"))
            comparison["streams"].append({"index": actual["index"], "method": "decoded_pcm_sha256", "bytes": count})
        else:
            counts = compare_packet_stream(source, options, output, original["index"], actual["index"],
                                           chapter_numbers, offsets, {}, kind)
            comparison["streams"].append({"index": actual["index"], "method": "packet_sha256", "packets": sum(counts)})
    return comparison


def compare_dvd(source, options, output, title=None):
    try:
        return compare_dvd_media(source, options, output, title)
    except SourceComparisonError as whole_error:
        if not title or len(title[2]) <= 1:
            raise
        try:
            return compare_dvd_media(source, options, output, title, chapters=True)
        except SourceComparisonError as chapter_error:
            raise SourceComparisonError(
                f"Whole-title comparison failed: {whole_error}; chapter comparison failed: {chapter_error}"
            ) from chapter_error


def extract(source, out, kind):
    identity = source_identity(source)
    expected = inventory(source, kind)
    galleries = confirmed_galleries(source) if kind == "title" else {}
    out.mkdir(parents=True, exist_ok=True)
    fd = os.open(out, os.O_RDONLY | os.O_DIRECTORY)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        for name, item in expected.items():
            path = out / name
            title = item if kind == "title" else None
            if title and title[0] in galleries:
                destination = gallery_destination(out.parent, title[0])
                if not (destination / "manifest.json").is_file():
                    print(f"Title {title[0]} is an interactive still gallery. Export it with:\n"
                          f"  {gallery_command(source, destination, title[0])}")
                continue
            options = ["-title", str(title[0]), "-trim", "0", "-preindex", "1"] if title else item
            receipt = matching_receipt(path, identity)
            if receipt is not None and receipt.get("status") != "incomplete":
                check = None
                try:
                    if title:
                        check = completeness(title, probe(path))
                        if "error" in check:
                            raise SourceComparisonError(check["error"])
                    comparison = compare_dvd(source, options, path, title)
                    write_receipt(path, identity, receipt["sha256"], check, comparison)
                    print(f"Source comparison passed; skipping {path}")
                    for warning in (check or {}).get("warnings", []) + comparison.get("warnings", []):
                        print(f"Warning: {path}: {warning}", file=sys.stderr)
                    continue
                except (ValueError, OSError, subprocess.CalledProcessError) as exc:
                    comparison = {"verified": False, "error": str(exc)}
                    write_receipt(path, identity, receipt["sha256"], check, comparison)
                    print(f"{path}: {exc}; re-extracting", file=sys.stderr)
            temp_fd, temp_name = tempfile.mkstemp(prefix=f".{name}.", suffix=".part", dir=out)
            os.close(temp_fd)
            temporary = Path(temp_name)
            try:
                remux_dvd(source, options, temporary)
                observed = probe(temporary)
                check = completeness(title, observed) if title else None
                recovered = False
                if check and "error" in check and len(title[2]) > 1:
                    print(f"{name}: {check['error']}. Retrying by chapter.", file=sys.stderr)
                    recover_chapters(source, title, temporary)
                    recovered = True
                    check = completeness(title, probe(temporary))
                if check and "error" in check:
                    raise ValueError(f"{name}: {check['error']}")
                try:
                    comparison = compare_dvd(source, options, temporary, title)
                except SourceComparisonError:
                    if not title or len(title[2]) <= 1 or recovered:
                        raise
                    print(f"{name}: source comparison failed. Retrying by chapter.", file=sys.stderr)
                    recover_chapters(source, title, temporary)
                    check = completeness(title, probe(temporary))
                    if "error" in check:
                        raise ValueError(f"{name}: {check['error']}")
                    comparison = compare_dvd(source, options, temporary, title)
                checksum = digest(temporary)
                with temporary.open("rb") as handle:
                    os.fsync(handle.fileno())
                receipt_path(path).unlink(missing_ok=True)
                os.replace(temporary, path)
                write_receipt(path, identity, checksum, check, comparison)
                for warning in (check or {}).get("warnings", []) + comparison.get("warnings", []):
                    print(f"Warning: {path}: {warning}", file=sys.stderr)
            finally:
                temporary.unlink(missing_ok=True)
    finally:
        os.close(fd)


def verify(source, root):
    if not root.is_dir():
        raise ValueError(f"Not a directory: {root}")
    identity = source_identity(source)
    galleries = confirmed_galleries(source)
    trace_cache = {}
    expected = {}
    for kind, directory in (("title", "titles"), ("menu", "menus")):
        expected.update({f"{directory}/{name}": (kind, item)
                         for name, item in inventory(source, kind).items()})
    actual = {str(p.relative_to(root)) for directory in ("titles", "menus")
              for p in (root / directory).glob("*.mkv")}
    for number in galleries:
        mkv = f"titles/title_{number:03d}.mkv"
        expected.pop(mkv, None)
        actual.discard(mkv)
        index = gallery_destination(root, number) / "index.html"
        expected[str(index.relative_to(root))] = ("gallery", number)
    entries = []
    for name in sorted(set(expected) | actual):
        path = root / name
        entry = {"file": name, "kind": expected.get(name, ("unknown", None))[0], "verified": False}
        try:
            if name not in expected:
                raise ValueError("Unexpected file: absent from source inventory")
            kind, item = expected[name]
            if kind == "gallery":
                if not (path.parent / "manifest.json").is_file():
                    entry["status"] = "pending"
                    entry["command"] = gallery_command(source, path.parent, item)
                    raise ValueError(f"Gallery export pending. Run: {entry['command']}")
                graph = gallery_graph(source, item, galleries, trace_cache)
                entry["image_count"] = verify_gallery(path.parent, identity, item, graph)
                entry["verified"] = True
                print(f"{name}: verified. Open {path}", file=sys.stderr)
                entries.append(entry)
                continue
            if not path.is_file():
                raise ValueError("Expected file is missing")
            fd = os.open(path.parent, os.O_RDONLY | os.O_DIRECTORY)
            try:
                fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
                receipt = matching_receipt(path, identity)
                if receipt is None:
                    raise ValueError("Missing or invalid completion receipt, source mismatch, or checksum mismatch; re-extract")
                entry.update(probe(path))
                entry["sha256"] = receipt["sha256"]
                title = item if kind == "title" else None
                options = ["-title", str(title[0]), "-trim", "0", "-preindex", "1"] if title else item
                check = completeness(title, entry) if title else None
                try:
                    if check:
                        entry.update(check)
                        if "error" in check:
                            raise SourceComparisonError(check["error"])
                    comparison = compare_dvd(source, options, path, title)
                except (ValueError, OSError, subprocess.CalledProcessError) as exc:
                    comparison = {"verified": False, "error": str(exc)}
                    entry["source_comparison"] = comparison
                    write_receipt(path, identity, receipt["sha256"], check, comparison)
                    raise
                entry["source_comparison"] = comparison
                if comparison.get("warnings"):
                    entry["warnings"] = [*entry.get("warnings", []), *comparison["warnings"]]
                write_receipt(path, identity, receipt["sha256"], check, comparison)
            finally:
                os.close(fd)
        except (OSError, ValueError) as exc:
            entry["verified"] = False
            entry["error"] = str(exc)
        entries.append(entry)
        print(f"{name}: {'verified' if entry['verified'] else entry['error']}", file=sys.stderr)
        for warning in entry.get("warnings", []):
            print(f"{name}: warning: {warning}", file=sys.stderr)
    failures = sum(not e["verified"] for e in entries)
    manifest = {"format": "disc-archive-tools dvd-video manifest", "version": 2,
                "source": {"path": str(source.resolve()), **identity}, "files": entries,
                "summary": {"files": len(entries), "verified": len(entries) - failures, "failed": failures,
                            "warnings": sum(bool(e.get("warnings")) for e in entries)}}
    path = publish_manifest(root, manifest)
    print(f"Verification result: {path}")
    return 1 if failures or not expected else 0


def main(mode=None):
    args = sys.argv[1:]
    if mode is None:
        if not args:
            print("Usage: dvd-archive <title|menu|verify|gallery> <source> [output]", file=sys.stderr)
            return 1
        mode, *args = args
    if mode == "gallery":
        if len(args) != 3:
            print("Usage: dvd-gallery-extract SOURCE TITLE OUTPUT", file=sys.stderr)
            return 1
        try:
            extract_gallery(Path(args[0]).resolve(), int(args[1]), Path(args[2]).resolve())
            return 0
        except (OSError, ValueError, subprocess.CalledProcessError) as exc:
            print(f"Error: {exc}", file=sys.stderr)
            return 1
    if mode not in {"title", "menu", "verify"} or len(args) not in ({2} if mode == "verify" else {1, 2}):
        print("Usage: <command> <dvd.iso|dvd-directory> [output-directory]", file=sys.stderr)
        return 1
    source = Path(args[0]).resolve()
    out = Path(args[1] if len(args) == 2 else {"title": "titles", "menu": "menus"}[mode]).resolve()
    try:
        if mode == "verify":
            return verify(source, out)
        extract(source, out, mode)
        return 0
    except (OSError, ValueError, subprocess.CalledProcessError) as exc:
        print(f"Error: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
