"""Extract and verify authored Blu-ray playlists."""
import argparse
import fcntl
import hashlib
from contextlib import ExitStack
from itertools import zip_longest
import json
import math
import os
from pathlib import Path
import re
import runpy
import select
import shlex
import shutil
import subprocess
import sys
import tempfile

dvd = runpy.run_path(str(Path(__file__).resolve().with_name("dvd-archive")))
FFMPEG = dvd["FFMPEG"]
FFPROBE = dvd["FFPROBE"]
digest = dvd["digest"]
atomic_json = dvd["atomic_json"]
publish_manifest = dvd["publish_manifest"]
archive_prefix = dvd["archive_prefix"]
prefixed_name = dvd["prefixed_name"]

CODECS = {
    0x01: "mpeg1video", 0x02: "mpeg2video", 0x1b: "h264", 0x24: "hevc", 0xea: "vc1",
    0x03: "mp3", 0x04: "mp3", 0x80: "pcm_bluray", 0x81: "ac3", 0x82: "dts",
    0x83: "truehd", 0x84: "eac3", 0x85: "dts", 0x86: "dts", 0x90: "hdmv_pgs_subtitle",
}

class TimestampDiscontinuity(ValueError):
    """An output packet has a repeated or backwards decoding timestamp."""


def format_bytes(value):
    for unit in ("B", "KiB", "MiB", "GiB", "TiB"):
        if value < 1024 or unit == "TiB":
            return f"{value:.0f} {unit}" if unit == "B" else f"{value:.1f} {unit}"
        value /= 1024


def format_time(seconds):
    seconds = max(0, int(seconds))
    hours, seconds = divmod(seconds, 3600)
    minutes, seconds = divmod(seconds, 60)
    return f"{hours:d}:{minutes:02d}:{seconds:02d}"


class Progress:
    """Adaptive terminal status for source fingerprints and FFmpeg work."""
    frames = ("⌛", "⏳")

    def __init__(self, stream=None, interactive=None):
        self.stream = stream or sys.stderr
        self.interactive = (self.stream.isatty() if interactive is None else interactive)
        self.active = False
        self.count = 0
        self.last_percent = None

    def show(self, message, final=False):
        if self.interactive:
            prefix = "✓" if final else self.frames[self.count % len(self.frames)]
            self.count += 1
            end = "\n" if final else ""
            self.stream.write(f"\r\033[2K{prefix} {message}{end}")
            self.stream.flush()
        else:
            self.stream.write(f"{message}\n")
            self.stream.flush()

    def clear(self):
        if self.interactive and self.active:
            self.stream.write("\r\033[2K")
            self.stream.flush()
        self.active = False

    def fingerprint(self, processed, total, path, final=False):
        percent = 100 if not total else min(100, processed * 100 / total)
        if (not self.interactive and not final and self.last_percent is not None
                and percent < self.last_percent + 5):
            return
        self.last_percent = percent
        self.active = not final
        self.show(f"Fingerprinting {percent:5.1f}%  {format_bytes(processed)} / "
                  f"{format_bytes(total)}  {path}", final=final)

    def playlist(self, label, position, duration, speed="", final=False):
        if final:
            position = duration
        percent = 100 if not duration else min(100, position * 100 / duration)
        suffix = f"  {speed}" if speed else ""
        self.active = not final
        self.show(f"{label}: {format_time(position)} / {format_time(duration)} "
                  f"({percent:5.1f}%){suffix}", final=final)


def digest_with_progress(path, progress, processed, total, label=None):
    result = hashlib.sha256()
    with path.open("rb") as handle:
        for block in iter(lambda: handle.read(1024 * 1024), b""):
            result.update(block)
            processed += len(block)
            progress.fingerprint(processed, total, label or path.name)
    return result.hexdigest(), processed


def source_details(source, progress=None):
    source = source.resolve(strict=True)
    if source.is_file():
        if progress is None:
            return source, {"type": "file", "sha256": digest(source)}
        total = source.stat().st_size
        progress.fingerprint(0, total, source.name)
        checksum, processed = digest_with_progress(source, progress, 0, total)
        progress.fingerprint(processed, total, source.name, final=True)
        return source, {"type": "file", "sha256": checksum}
    if source.name.upper() == "BDMV":
        bdmv = source
        source = source.parent
    else:
        matches = [p for p in source.iterdir() if p.is_dir() and p.name.upper() == "BDMV"]
        if len(matches) != 1:
            raise ValueError("Blu-ray directory must contain exactly one BDMV directory")
        bdmv = matches[0]
    paths = []
    for path in sorted(bdmv.rglob("*")):
        if path.is_symlink():
            raise ValueError(f"Symbolic link in BDMV source: {path}")
        if path.is_file():
            paths.append(path)
    if not paths:
        raise ValueError("BDMV directory is empty")
    if progress is None:
        files = [{"file": str(path.relative_to(source)), "sha256": digest(path)} for path in paths]
    else:
        total = sum(path.stat().st_size for path in paths)
        processed = 0
        files = []
        progress.fingerprint(0, total, paths[0].relative_to(source))
        for path in paths:
            checksum, processed = digest_with_progress(
                path, progress, processed, total, path.relative_to(source)
            )
            files.append({"file": str(path.relative_to(source)), "sha256": checksum})
        progress.fingerprint(processed, total, paths[-1].relative_to(source), final=True)
    return source, {"type": "directory", "files": files}


def write_log_note(log, message):
    with log.open("a", encoding="utf-8") as diagnostics:
        diagnostics.write(message + "\n")
    print(message, file=sys.stderr, flush=True)


def parse_progress(line, state):
    if "=" not in line:
        return None
    key, value = line.split("=", 1)
    if key in ("out_time_us", "out_time_ms"):
        try:
            state["position"] = int(value) / 1_000_000
        except ValueError:
            return None
    elif key == "speed":
        state["speed"] = value
    elif key == "progress":
        return value
    return None


def run_ffmpeg(command, log, label, duration, append=False):
    """Run FFmpeg, mirror its transcript to a log, and show live terminal state."""
    mode = "ab" if append else "wb"
    progress = Progress()
    if not progress.interactive:
        print(f"{label}: FFmpeg started; writing {log}", file=sys.stderr, flush=True)
        with log.open("a" if append else "w", encoding="utf-8") as diagnostics:
            diagnostics.write(f"=== FFmpeg command ===\n{shlex.join(command)}\n")
            result = subprocess.run(command, stdout=diagnostics, stderr=subprocess.STDOUT)
        print(f"{label}: FFmpeg {'completed' if not result.returncode else 'failed'}", file=sys.stderr,
              flush=True)
        return result

    read_fd, write_fd = os.pipe()
    progress_command = command.copy()
    position = progress_command.index("-nostdin") + 1
    progress_command[position:position] = ["-nostats", "-progress", f"pipe:{write_fd}"]
    with log.open(mode) as diagnostics:
        diagnostics.write((f"=== FFmpeg command ===\n{shlex.join(progress_command)}\n").encode())
        diagnostics.flush()
        try:
            process = subprocess.Popen(progress_command, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                                       pass_fds=(write_fd,))
        finally:
            os.close(write_fd)
        state = {"position": 0.0, "speed": ""}
        buffers = {read_fd: b""}
        descriptors = [process.stdout.fileno(), read_fd]
        try:
            while descriptors:
                readable, _, _ = select.select(descriptors, [], [])
                for descriptor in readable:
                    data = os.read(descriptor, 8192)
                    if not data:
                        descriptors.remove(descriptor)
                        continue
                    if descriptor == process.stdout.fileno():
                        progress.clear()
                        diagnostics.write(data)
                        diagnostics.flush()
                        sys.stderr.buffer.write(data)
                        sys.stderr.buffer.flush()
                        progress.playlist(label, state["position"], duration, state["speed"])
                    else:
                        buffers[descriptor] += data
                        lines = buffers[descriptor].split(b"\n")
                        buffers[descriptor] = lines.pop()
                        for line in lines:
                            event = parse_progress(line.decode("utf-8", "replace"), state)
                            if event is not None:
                                progress.playlist(label, state["position"], duration,
                                                  state["speed"], final=event == "end")
        finally:
            os.close(read_fd)
            process.stdout.close()
        result = subprocess.CompletedProcess(progress_command, process.wait())
    progress.playlist(label, state["position"], duration, state["speed"], final=True)
    return result


def info_tool():
    local = Path(__file__).resolve().parent.parent / "build-bluray-info"
    if local.is_file() and os.access(local, os.X_OK):
        return str(local)
    installed = shutil.which("bluray-info")
    if not installed:
        raise ValueError("bluray-info not found; run make or install disc-archive-tools")
    return installed


def inventory(source):
    # libbluray can print messages directly to stdout, so write its JSON to a file.
    with tempfile.TemporaryFile(mode="w+") as output:
        result = subprocess.run([info_tool(), str(source)], stdout=output,
                                stderr=subprocess.PIPE, text=True)
        output.seek(0)
        text = output.read()
    if result.returncode:
        raise ValueError(f"Blu-ray inventory failed: {result.stderr.strip()}")
    try:
        data = json.loads(text[text.index('{"menus":'):])
        playlists = data["playlists"]
        result = {p["id"]: p for p in playlists}
        if len(result) != len(playlists) or not result:
            raise ValueError("Duplicate or empty playlist inventory")
    except (ValueError, KeyError, TypeError) as exc:
        raise ValueError(f"Invalid Blu-ray inventory: {exc}") from exc
    if source.is_dir():
        bdmv = next(p for p in source.iterdir() if p.is_dir() and p.name.upper() == "BDMV")
        directories = [p for p in bdmv.iterdir() if p.is_dir() and p.name.upper() == "PLAYLIST"]
        if len(directories) != 1:
            raise ValueError("Cannot find the source PLAYLIST directory")
        files = {int(p.stem) for p in directories[0].iterdir()
                 if p.is_file() and re.fullmatch(r"\d{5}\.mpls", p.name, re.I)}
        if files != set(result):
            raise ValueError(f"libbluray inventory differs from MPLS files: missing {sorted(files - set(result))}, unexpected {sorted(set(result) - files)}")
    return result, data["menus"]


def expected_streams(playlist):
    streams = {}
    for clip in playlist["clips"]:
        if clip["still_mode"]:
            raise ValueError("Playlist contains an interactive or timed still")
        if clip["secondary_audio"] or clip["secondary_video"]:
            raise ValueError("Playlist contains secondary audio or video")
        for stream in clip["streams"]:
            if stream["coding"] not in CODECS:
                raise ValueError(f"Unsupported Blu-ray stream coding 0x{stream['coding']:02x}")
            key = (stream["type"], stream["pid"])
            codec = CODECS[stream["coding"]]
            language = stream.get("language", "").strip()
            if language and not re.fullmatch(r"[A-Za-z]{3}", language):
                raise ValueError(f"Invalid language for stream PID {stream['pid']}")
            old = streams.get(key)
            if old and (old["codec"] != codec or
                        (language and old["language"] and language != old["language"])):
                raise ValueError(f"Stream PID {stream['pid']} changes codec or language")
            streams[key] = {"codec": codec, "language": language or (old["language"] if old else "")}
    if playlist["angles"] != 1:
        raise ValueError(f"Playlist has {playlist['angles']} angles")
    if not any(kind == "video" for kind, _ in streams):
        raise ValueError("Playlist has no video stream")
    return streams


def probe(path):
    result = subprocess.run([FFPROBE, "-v", "error", "-show_format", "-show_streams",
                             "-show_chapters", "-of", "json", str(path)],
                            capture_output=True, text=True, check=True)
    return json.loads(result.stdout)


def check_packet_timestamps(path):
    command = [FFPROBE, "-v", "error", "-show_packets",
               "-show_entries", "packet=stream_index,dts_time", "-of", "csv=p=0", str(path)]
    with tempfile.TemporaryFile(mode="w+") as errors:
        process = subprocess.Popen(command, stdout=subprocess.PIPE, stderr=errors, text=True)
        previous = {}
        try:
            for line in process.stdout:
                fields = line.strip().split(",")
                if len(fields) < 2 or fields[1] == "N/A":
                    continue
                index, timestamp = int(fields[0]), float(fields[1])
                if not math.isfinite(timestamp):
                    raise ValueError(f"Invalid packet timestamp in stream {index}")
                if index in previous and timestamp <= previous[index]:
                    raise TimestampDiscontinuity(
                        f"Non-increasing DTS in stream {index}: {previous[index]:.6f}s then {timestamp:.6f}s"
                    )
                previous[index] = timestamp
        except (ValueError, OSError):
            process.terminate()
            process.wait()
            raise
        finally:
            process.stdout.close()
        if process.wait():
            errors.seek(0)
            raise ValueError(f"Packet inspection failed: {errors.read().strip()}")


def completeness(playlist, media):
    expected = expected_streams(playlist)
    try:
        duration = float(media["format"]["duration"])
        chapters = [float(c["start_time"]) for c in media.get("chapters", [])]
    except (KeyError, TypeError, ValueError) as exc:
        raise ValueError(f"Invalid media metadata: {exc}") from exc
    if not math.isfinite(duration) or abs(duration - playlist["duration"]) > 1 + playlist["duration"] * 0.0015:
        raise ValueError(f"Duration mismatch: expected {playlist['duration']:.3f}s, found {duration:.3f}s")
    if len(chapters) != len(playlist["chapters"]) or any(
            not math.isfinite(actual) or abs(actual - expected_time) > 0.15
            for actual, expected_time in zip(chapters, playlist["chapters"])):
        raise ValueError(f"Chapter mismatch: expected {playlist['chapters']}, found {chapters}")
    ordered = sorted(expected, key=lambda key: ({"video": 0, "audio": 1, "subtitle": 2}[key[0]], key[1]))
    found = [stream for stream in media.get("streams", [])
             if stream.get("codec_type") in ("video", "audio", "subtitle")]
    if len(found) != len(ordered):
        raise ValueError(f"Stream count mismatch: expected {len(ordered)}, found {len(found)}")
    for stream, key in zip(found, ordered):
        source_stream = expected[key]
        language = stream.get("tags", {}).get("language", "")
        if (stream.get("codec_type") != key[0] or stream.get("codec_name") != source_stream["codec"]
                or (source_stream["language"] and language != source_stream["language"])):
            raise ValueError(f"Stream mismatch for PID {key[1]}: expected {source_stream}, found {stream}")
    return {"duration": duration, "chapters": chapters, "streams": media["streams"]}


def receipt_path(path):
    return path.with_name(path.name + ".receipt.json")


def matching_receipt(path, identity, playlist):
    try:
        receipt = json.loads(receipt_path(path).read_text())
        if (receipt.get("version") == 1 and receipt.get("source") == identity
                and receipt.get("playlist") == playlist and receipt.get("file") == path.name
                and receipt.get("sha256") == digest(path)
                and receipt.get("status") in ("complete", "incomplete")):
            return receipt
    except (OSError, ValueError, AttributeError):
        pass
    return None


def metadata(path, playlist):
    lines = [";FFMETADATA1"]
    chapters = playlist["chapters"]
    for i, start in enumerate(chapters):
        end = chapters[i + 1] if i + 1 < len(chapters) else playlist["duration"]
        lines += ["[CHAPTER]", "TIMEBASE=1/90000", f"START={round(start * 90000)}",
                  f"END={round(end * 90000)}"]
    path.write_text("\n".join(lines) + "\n")


def boundary_correction(playlist, streams):
    """Identify a two-clip video transition with audio confined to the first clip."""
    clips = playlist["clips"]
    if len(clips) != 2 or len(streams) != 2:
        return None
    video = [key for key in streams if key[0] == "video"]
    audio = [key for key in streams if key[0] == "audio"]
    if len(video) != 1 or len(audio) != 1:
        return None
    first = {(stream["type"], stream["pid"]) for stream in clips[0]["streams"]}
    second = {(stream["type"], stream["pid"]) for stream in clips[1]["streams"]}
    if first != set(streams) or second != set(video):
        return None
    # MPEG-TS timestamps wrap at 2**33 ticks. After the discontinuity, FFmpeg
    # may expose the new clip in the next wrap instead of playlist time.
    jump = (2 ** 33) / 90000 + clips[1]["in"] - clips[0]["out"]
    wrapped_start = clips[1]["start"] + jump
    if not math.isfinite(jump) or wrapped_start <= playlist["duration"] + 1:
        return None
    threshold = (playlist["duration"] + wrapped_start) / 2
    return {"jump_seconds": jump, "threshold_seconds": threshold,
            "source_start_seconds": clips[0]["in"]}


def compare_boundary_packets(source, number, output, streams, correction):
    """Compare all source packets, payload hashes and mapped timestamps."""
    ordered = sorted(streams, key=lambda key: ({"video": 0, "audio": 1}[key[0]], key[1]))
    counts = {}
    for kind, pid in ordered:
        selector = "v:0" if kind == "video" else "a:0"
        options = ["-show_packets", "-show_entries",
                   "packet=pts_time,dts_time,duration_time,data_hash",
                   "-show_data_hash", "sha256", "-of", "compact=p=0:nk=0"]
        input_command = [FFPROBE, "-v", "error", "-playlist", str(number),
                         "-select_streams", f"i:0x{pid:x}", *options, "bluray:" + str(source)]
        output_command = [FFPROBE, "-v", "error", "-select_streams", selector, *options, str(output)]
        with ExitStack() as stack:
            input_errors = stack.enter_context(tempfile.TemporaryFile(mode="w+"))
            output_errors = stack.enter_context(tempfile.TemporaryFile(mode="w+"))
            processes = []
            try:
                for command, errors in ((input_command, input_errors), (output_command, output_errors)):
                    processes.append(subprocess.Popen(command, stdout=subprocess.PIPE,
                                                      stderr=errors, text=True))
                count = 0
                for source_line, output_line in zip_longest(processes[0].stdout, processes[1].stdout):
                    if source_line is None or output_line is None:
                        raise ValueError(f"{kind} packet count differs from the source")
                    original = dict(field.split("=", 1) for field in source_line.strip().split("|") if "=" in field)
                    actual = dict(field.split("=", 1) for field in output_line.strip().split("|") if "=" in field)
                    count += 1
                    if not original.get("data_hash") or original["data_hash"] != actual.get("data_hash"):
                        raise ValueError(f"{kind} packet {count} differs from the source")
                    for field in ("pts_time", "dts_time", "duration_time"):
                        try:
                            expected_time = float(original[field])
                            actual_time = float(actual[field])
                        except (KeyError, ValueError) as exc:
                            raise ValueError(f"{kind} packet {count} has no usable {field}") from exc
                        if field != "duration_time":
                            expected_time -= correction["source_start_seconds"]
                            if kind == "video" and expected_time >= correction["threshold_seconds"]:
                                expected_time -= correction["jump_seconds"]
                        if (not math.isfinite(expected_time) or not math.isfinite(actual_time)
                                or abs(expected_time - actual_time) > 0.002):
                            raise ValueError(f"{kind} packet {count} {field} differs from the source")
                if not count:
                    raise ValueError(f"No {kind} packets found")
                for process, errors in zip(processes, (input_errors, output_errors)):
                    if process.wait():
                        errors.seek(0)
                        raise ValueError(f"{kind} packet comparison failed: {errors.read().strip()}")
                counts[kind] = count
            finally:
                for process in processes:
                    if process.poll() is None:
                        process.terminate()
                    process.stdout.close()
                    process.wait()
    return counts


def extract(source, root, identity, playlists, prefix=""):
    titles = root / "titles"
    logs = root / "logs"
    titles.mkdir(parents=True, exist_ok=True)
    logs.mkdir(parents=True, exist_ok=True)
    fd = os.open(titles, os.O_RDONLY | os.O_DIRECTORY)
    failures = 0
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        for number, playlist in sorted(playlists.items()):
            name = prefixed_name(f"playlist_{number:05d}.mkv", prefix)
            path = titles / name
            log = logs / f"playlist_{number:05d}.log"
            try:
                streams = expected_streams(playlist)
                receipt = matching_receipt(path, identity, number)
                if receipt and receipt["status"] == "complete":
                    try:
                        completeness(playlist, probe(path))
                        check_packet_timestamps(path)
                    except (ValueError, subprocess.CalledProcessError) as exc:
                        receipt.update({"status": "incomplete", "error": str(exc)})
                        atomic_json(receipt_path(path), receipt)
                        print(f"{name}: existing output is incomplete; re-extracting", file=sys.stderr)
                    else:
                        print(f"{name}: already complete", flush=True)
                        continue
                with tempfile.TemporaryDirectory(prefix=f".playlist_{number:05d}.", dir=titles) as directory:
                    work = Path(directory)
                    meta = work / "chapters.ffmetadata"
                    temp = work / "output.mkv"
                    metadata(meta, playlist)
                    command = [FFMPEG, "-nostdin", "-xerror", "-y",
                               "-playlist", str(number), "-i", "bluray:" + str(source),
                               "-f", "ffmetadata", "-i", str(meta)]
                    ordered = sorted(streams, key=lambda key: (
                        {"video": 0, "audio": 1, "subtitle": 2}[key[0]], key[1]))
                    for kind, pid in ordered:
                        command.extend(["-map", f"0:i:0x{pid:x}"])
                    command.extend(["-map_metadata", "-1", "-map_chapters", "1", "-c", "copy"])
                    positions = {"video": 0, "audio": 0, "subtitle": 0}
                    specifiers = {"video": "v", "audio": "a", "subtitle": "s"}
                    for kind, pid in ordered:
                        language = streams[(kind, pid)]["language"]
                        if language:
                            command.extend([f"-metadata:s:{specifiers[kind]}:{positions[kind]}",
                                            f"language={language}"])
                        positions[kind] += 1
                    command.extend(["-f", "matroska", str(temp)])
                    result = run_ffmpeg(command, log, name, playlist["duration"])
                    diagnostic_text = log.read_text(errors="replace")
                    if result.returncode and any(message in diagnostic_text for message in
                                                 ("dimensions not set", "sample rate not set")):
                        retry = command.copy()
                        position = retry.index("-playlist")
                        retry[position:position] = ["-probesize", "256M", "-analyzeduration", "150M"]
                        write_log_note(log, "Retrying with a larger input probe.")
                        result = run_ffmpeg(retry, log, name, playlist["duration"], append=True)
                    if result.returncode:
                        diagnostics = log.read_text(errors="replace")
                        reason = next((line.strip() for line in reversed(diagnostics.splitlines())
                                       if any(message in line for message in
                                              ("dimensions not set", "sample rate not set",
                                               "Packet corrupt", "corrupt input packet",
                                               "Could not write header"))), "")
                        detail = f": {reason}" if reason else ""
                        raise ValueError(f"FFmpeg failed ({result.returncode}){detail}; see {log}")
                    observed = completeness(playlist, probe(temp))
                    correction = None
                    try:
                        check_packet_timestamps(temp)
                    except TimestampDiscontinuity:
                        correction = boundary_correction(playlist, streams)
                        if correction is None:
                            raise
                        retry = command.copy()
                        position = retry.index("-playlist")
                        retry[position:position] = ["-copyts", "-start_at_zero"]
                        jump = correction["jump_seconds"]
                        threshold = correction["threshold_seconds"]
                        expression = (
                            f"setts=pts=if(gte(PTS*TB\\,{threshold:.9f})\\,PTS-{jump:.9f}/TB\\,PTS):"
                            f"dts=if(gte(DTS*TB\\,{threshold:.9f})\\,DTS-{jump:.9f}/TB\\,DTS)"
                        )
                        retry[-3:-3] = ["-bsf:v", expression]
                        write_log_note(
                            log, f"Retrying with original timestamps and a {jump:.9f}s "
                            f"video wrap adjustment at {threshold:.9f}s."
                        )
                        result = run_ffmpeg(retry, log, name, playlist["duration"], append=True)
                        if result.returncode:
                            raise ValueError(f"Timestamp correction failed ({result.returncode}); see {log}")
                        observed = completeness(playlist, probe(temp))
                        check_packet_timestamps(temp)
                        correction["packets_checked"] = compare_boundary_packets(
                            source, number, temp, streams, correction)
                        write_log_note(log, f"Source packet comparison passed: {correction['packets_checked']}")
                    checksum = digest(temp)
                    with temp.open("rb") as handle:
                        os.fsync(handle.fileno())
                    receipt_path(path).unlink(missing_ok=True)
                    os.replace(temp, path)
                    receipt = {"version": 1, "status": "complete",
                        "source": identity, "playlist": number, "file": name,
                        "sha256": checksum, "expected": playlist, "observed": observed}
                    if correction:
                        receipt["timestamp_correction"] = correction
                    atomic_json(receipt_path(path), receipt)
                print(f"{name}: extracted", flush=True)
            except (ValueError, OSError, subprocess.CalledProcessError, KeyError) as exc:
                failures += 1
                with log.open("a") as diagnostics:
                    diagnostics.write(f"\nExtraction failed: {exc}\n")
                print(f"{name}: {exc}", file=sys.stderr, flush=True)
    finally:
        os.close(fd)
    return failures


def verify(source, root, identity, playlists, menus, prefix=""):
    titles = root / "titles"
    if not titles.is_dir():
        return verify_locked(source, root, identity, playlists, menus, prefix)
    fd = os.open(titles, os.O_RDONLY | os.O_DIRECTORY)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        return verify_locked(source, root, identity, playlists, menus, prefix)
    finally:
        os.close(fd)


def verify_locked(source, root, identity, playlists, menus, prefix=""):
    entries = []
    titles = root / "titles"
    actual = {p.name for p in titles.glob("*.mkv")} if titles.is_dir() else set()
    expected = {prefixed_name(f"playlist_{n:05d}.mkv", prefix): n for n in playlists}
    for name in sorted(set(expected) | actual):
        path = titles / name
        entry = {"file": f"titles/{name}", "verified": False}
        try:
            if name not in expected:
                raise ValueError("Unexpected file: absent from source inventory")
            number = expected[name]
            playlist = playlists[number]
            entry.update({"playlist": number, "expected": playlist,
                          "log": f"logs/playlist_{number:05d}.log"})
            expected_streams(playlist)
            if not path.is_file():
                log_path = root / entry["log"]
                if log_path.is_file():
                    for line in reversed(log_path.read_text(errors="replace").splitlines()):
                        if line.startswith("Extraction failed: "):
                            entry["extraction_error"] = line.removeprefix("Extraction failed: ")
                            break
                raise ValueError("Expected playlist output is missing")
            receipt = matching_receipt(path, identity, number)
            if not receipt:
                raise ValueError("Missing or invalid completion receipt, source mismatch, or checksum mismatch")
            if receipt["status"] == "incomplete":
                raise ValueError(receipt.get("error", "Incomplete playlist output; re-extract"))
            try:
                entry["observed"] = completeness(playlist, probe(path))
                check_packet_timestamps(path)
            except (ValueError, subprocess.CalledProcessError) as exc:
                receipt.update({"status": "incomplete", "error": str(exc)})
                atomic_json(receipt_path(path), receipt)
                raise
            entry["sha256"] = receipt["sha256"]
            entry["verified"] = True
        except (ValueError, OSError, subprocess.CalledProcessError, KeyError) as exc:
            entry["error"] = str(exc)
        entries.append(entry)
        print(f"{name}: {'verified' if entry['verified'] else entry['error']}", file=sys.stderr)
    failed = sum(not entry["verified"] for entry in entries)
    report = {"format": "disc-archive-tools blu-ray manifest", "version": 1,
              "source": {"path": str(source), **identity}, "menus": {
                  **menus, "interactive_graphics_playlists": [
                      n for n, p in sorted(playlists.items())
                      if any(c["interactive_graphics"] for c in p["clips"])],
                  "preservation": "not yet supported"},
              "files": entries, "summary": {"files": len(entries),
                                            "verified": len(entries) - failed, "failed": failed}}
    path = publish_manifest(root, report)
    print(f"Verification result: {path}")
    return int(bool(failed))


def main(mode):
    parser = argparse.ArgumentParser()
    parser.add_argument("--name", help="disc name used as the filename prefix")
    parser.add_argument("source")
    parser.add_argument("output", nargs="?" if mode != "verify" else None, default="bluray-extract")
    parsed = parser.parse_args()
    try:
        source, identity = source_details(Path(parsed.source), Progress())
        playlists, menus = inventory(source)
        out = Path(parsed.output).resolve()
        if mode == "verify" and not out.is_dir():
            raise ValueError(f"Not a directory: {out}")
        if source.is_dir():
            bdmv = next(p for p in source.iterdir() if p.is_dir() and p.name.upper() == "BDMV")
            if out == bdmv or bdmv in out.parents:
                raise ValueError("Output must be outside the source BDMV directory")
        out.mkdir(parents=True, exist_ok=True)
        print(f"Discovered {len(playlists)} playlists. Blu-ray menu preservation is not yet supported.", flush=True)
        prefix = archive_prefix(out / "titles", Path(parsed.source).resolve(), parsed.name,
                                create=mode != "verify", kind="playlist")
        if mode == "verify":
            return verify(source, out, identity, playlists, menus, prefix)
        failures = extract(source, out, identity, playlists, prefix)
        if mode == "extract":
            failures += verify(source, out, identity, playlists, menus, prefix)
        return int(bool(failures))
    except (OSError, ValueError, subprocess.CalledProcessError) as exc:
        print(f"Error: {exc}", file=sys.stderr)
        return 1
